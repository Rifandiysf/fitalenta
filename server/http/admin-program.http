@baseUrl = http://localhost:5000/api
@adminEmail = admin@fitalenta.id
@adminPassword = Admin@123
@participantEmail = siti.rahmawati@example.com
@participantPassword = rahasia123

###
# 0. GAGAL 401: token tidak valid
GET {{baseUrl}}/admin/programs
Cookie: access_token=token-palsu

###
# 1. Login admin
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###
# 2. Ringkasan program (summary cards)
GET {{baseUrl}}/admin/programs/summary

###
# 3. Opsi filter (kategori, format, status)
# @name programOptions
GET {{baseUrl}}/admin/programs/options

###
# 4. Daftar program (tanpa filter)
# @name programList
GET {{baseUrl}}/admin/programs

###
# 5. Pencarian nama program
GET {{baseUrl}}/admin/programs?search=jepang

###
# 6. Filter berdasarkan status
GET {{baseUrl}}/admin/programs?status=active

###
# 7. Filter status inactive
GET {{baseUrl}}/admin/programs?status=inactive

###
# 8. Filter isRunning=true
GET {{baseUrl}}/admin/programs?isRunning=true

###
# 9. Filter kategori (memakai id pertama dari request #3)
GET {{baseUrl}}/admin/programs?categoryId={{programOptions.response.body.$.data.categories[0].id}}

###
# 10. Kombinasi filter + pencarian
GET {{baseUrl}}/admin/programs?status=active&isRunning=true&search=bahasa

###
# 11. Pagination
GET {{baseUrl}}/admin/programs?page=1&limit=5

###
# 12. GAGAL 400 VALIDATION_ERROR: status tidak valid
GET {{baseUrl}}/admin/programs?status=invalid-status&page=0&limit=1000

###
# 13. Detail program (memakai id pertama dari request #4)
GET {{baseUrl}}/admin/programs/{{programList.response.body.$.data[0].id}}

###
# 14. GAGAL 404 PROGRAM_NOT_FOUND
GET {{baseUrl}}/admin/programs/99999

###
# 15. GAGAL 400 VALIDATION_ERROR: id bukan angka
GET {{baseUrl}}/admin/programs/abc

###
# 16. SUKSES: Buat program baru (minimal — hanya name)
# @name createProgram
POST {{baseUrl}}/admin/programs
Content-Type: application/json

{
  "name": "Program Magang Jepang Batch 2026",
  "status": "active",
  "isRunning": false,
  "sortOrder": 10
}

###
# 17. SUKSES: Buat program lengkap
# @name createProgramFull
POST {{baseUrl}}/admin/programs
Content-Type: application/json

{
  "name": "Program Pelatihan Bahasa Korea B1",
  "programFormat": "Offline",
  "description": "Program pelatihan bahasa Korea untuk level B1",
  "requirements": "Minimal SMA/sederajat, usia 18-30 tahun",
  "schedule": "Senin - Jumat, 08.00 - 16.00",
  "duration": "3 bulan",
  "capacity": 30,
  "location": "Jakarta Selatan",
  "trainingCost": 5000000,
  "departureCost": 15000000,
  "downPayment": 2500000,
  "jobMatchingCost": 500000,
  "installmentPlan": "3_installments",
  "registrationDeadline": "2026-11-30",
  "startDate": "2026-12-15",
  "endDate": "2027-03-15",
  "status": "active",
  "isRunning": true,
  "sortOrder": 5
}

###
# 18. GAGAL 400 VALIDATION_ERROR: name wajib saat create
POST {{baseUrl}}/admin/programs
Content-Type: application/json

{
  "status": "active"
}

###
# 19. GAGAL 400 VALIDATION_ERROR: endDate sebelum startDate
POST {{baseUrl}}/admin/programs
Content-Type: application/json

{
  "name": "Program Invalid Date",
  "startDate": "2026-12-15",
  "endDate": "2026-11-01"
}

###
# 20. GAGAL 400 VALIDATION_ERROR: categoryId tidak ditemukan
POST {{baseUrl}}/admin/programs
Content-Type: application/json

{
  "name": "Program Kategori Salah",
  "categoryId": 99999
}

###
# 21. GAGAL 400 VALIDATION_ERROR: installmentPlan format salah
POST {{baseUrl}}/admin/programs
Content-Type: application/json

{
  "name": "Program Cicilan Invalid",
  "installmentPlan": "cicilan_3x"
}

###
# 22. SUKSES: Update program (memakai id dari request #16)
PUT {{baseUrl}}/admin/programs/{{createProgram.response.body.$.data.id}}
Content-Type: application/json

{
  "description": "Program magang ke Jepang batch tahun 2026 — kuota terbatas",
  "capacity": 25,
  "status": "active",
  "isRunning": true
}

###
# 23. SUKSES: Update sebagian field (partial update)
PUT {{baseUrl}}/admin/programs/{{createProgram.response.body.$.data.id}}
Content-Type: application/json

{
  "status": "inactive"
}

###
# 24. GAGAL 404 PROGRAM_NOT_FOUND: update program tidak ada
PUT {{baseUrl}}/admin/programs/99999
Content-Type: application/json

{
  "status": "active"
}

###
# 25. GAGAL 400 VALIDATION_ERROR: kapasitas di bawah jumlah peserta
PUT {{baseUrl}}/admin/programs/1
Content-Type: application/json

{
  "capacity": 0
}

###
# 26. SUKSES: Hapus program yang baru dibuat (tidak ada pendaftar)
DELETE {{baseUrl}}/admin/programs/{{createProgram.response.body.$.data.id}}

###
# 27. GAGAL 409 PROGRAM_HAS_REGISTRATIONS: hapus program yang sudah ada pendaftar
DELETE {{baseUrl}}/admin/programs/1

###
# 28. GAGAL 404 PROGRAM_NOT_FOUND: hapus program tidak ada
DELETE {{baseUrl}}/admin/programs/99999

###
# 29. GAGAL 400 VALIDATION_ERROR: id bukan angka
DELETE {{baseUrl}}/admin/programs/abc

###
# 30. Login sebagai peserta
# @name loginParticipant
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{participantEmail}}",
  "password": "{{participantPassword}}"
}

###
# 31. GAGAL 403: peserta mengakses admin programs
GET {{baseUrl}}/admin/programs
