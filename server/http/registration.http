@baseUrl = http://localhost:5000/api
@programId = 1
@boundary = ----FitalentaBoundary

###
# 1. Register user dummy baru (otomatis login & menyimpan cookie)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Siti Rahmawati",
  "email": "siti.rahmawati@example.com",
  "phone": "085712345678",
  "password": "rahasia123",
  "confirmPassword": "rahasia123"
}

###
# 2. Login (jalankan kalau user sudah ada / cookie hilang)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "siti.rahmawati@example.com",
  "password": "rahasia123"
}

###
# 3. Lihat daftar program (cari id yang status-nya active, lalu ubah @programId di atas)
GET {{baseUrl}}/programs

###
# 4. SUKSES: registrasi lengkap (Step 1 s/d Step 3)
# @name registerProgram
POST {{baseUrl}}/user/registrations
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="programId"

{{programId}}
--{{boundary}}
Content-Disposition: form-data; name="fullName"

Siti Rahmawati
--{{boundary}}
Content-Disposition: form-data; name="phone"

085712345678
--{{boundary}}
Content-Disposition: form-data; name="nik"

3204145407010002
--{{boundary}}
Content-Disposition: form-data; name="gender"

P
--{{boundary}}
Content-Disposition: form-data; name="birthPlace"

Bandung
--{{boundary}}
Content-Disposition: form-data; name="birthDate"

2001-07-14
--{{boundary}}
Content-Disposition: form-data; name="lastEducation"

D3
--{{boundary}}
Content-Disposition: form-data; name="major"

Teknik Informatika
--{{boundary}}
Content-Disposition: form-data; name="educationInstitution"

Politeknik Negeri Bandung
--{{boundary}}
Content-Disposition: form-data; name="currentActivity"

Karyawan Swasta
--{{boundary}}
Content-Disposition: form-data; name="maritalStatus"

Belum Menikah
--{{boundary}}
Content-Disposition: form-data; name="parentRelationship"

Ibu
--{{boundary}}
Content-Disposition: form-data; name="parentPhone"

081377788899
--{{boundary}}
Content-Disposition: form-data; name="ktpProvinceCode"

32
--{{boundary}}
Content-Disposition: form-data; name="ktpProvinceName"

Jawa Barat
--{{boundary}}
Content-Disposition: form-data; name="ktpCityCode"

3204
--{{boundary}}
Content-Disposition: form-data; name="ktpCityName"

Kabupaten Bandung
--{{boundary}}
Content-Disposition: form-data; name="ktpAddress"

Jl. Raya Soreang No. 45, RT 03 RW 07, Soreang
--{{boundary}}
Content-Disposition: form-data; name="domicileProvinceCode"

32
--{{boundary}}
Content-Disposition: form-data; name="domicileProvinceName"

Jawa Barat
--{{boundary}}
Content-Disposition: form-data; name="domicileCityCode"

3273
--{{boundary}}
Content-Disposition: form-data; name="domicileCityName"

Kota Bandung
--{{boundary}}
Content-Disposition: form-data; name="domicileAddress"

Jl. Cihampelas No. 88, Kos Mawar, Bandung
--{{boundary}}
Content-Disposition: form-data; name="photo"; filename="photo.png"
Content-Type: image/png

< ./dummy/photo.png
--{{boundary}}
Content-Disposition: form-data; name="n4Certificate"; filename="n4.png"
Content-Type: image/png

< ./dummy/n4.png
--{{boundary}}--

###
# 5. GAGAL 409 ALREADY_REGISTERED: kirim #4 sekali lagi dengan user yang sama.
# GAGAL 401: hapus cookie dulu (Ctrl+Shift+P > "Rest Client: Clear Cookies"), lalu kirim request ini
POST {{baseUrl}}/user/registrations
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}--

###
# 6. GAGAL 400 VALIDATION_ERROR: hanya programId (menampilkan semua field wajib)
POST {{baseUrl}}/user/registrations
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="programId"

{{programId}}
--{{boundary}}--

###
# 7. GAGAL 400 VALIDATION_ERROR: format data salah (folder uploads/registrations tidak boleh bertambah)
POST {{baseUrl}}/user/registrations
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="programId"

abc
--{{boundary}}
Content-Disposition: form-data; name="nik"

320414
--{{boundary}}
Content-Disposition: form-data; name="gender"

Z
--{{boundary}}
Content-Disposition: form-data; name="birthDate"

14-07-2001
--{{boundary}}
Content-Disposition: form-data; name="parentPhone"

0812
--{{boundary}}
Content-Disposition: form-data; name="photo"; filename="photo.png"
Content-Type: image/png

< ./dummy/photo.png
--{{boundary}}--

###
# 8. GAGAL 400 MISSING_FILES: data valid tapi tanpa pas foto (pakai user lain / program lain agar tidak kena ALREADY_REGISTERED)
POST {{baseUrl}}/user/registrations
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="programId"

{{programId}}
--{{boundary}}
Content-Disposition: form-data; name="nik"

3171024508000003
--{{boundary}}
Content-Disposition: form-data; name="gender"

L
--{{boundary}}
Content-Disposition: form-data; name="birthPlace"

Jakarta
--{{boundary}}
Content-Disposition: form-data; name="birthDate"

2000-08-05
--{{boundary}}
Content-Disposition: form-data; name="lastEducation"

SMA
--{{boundary}}
Content-Disposition: form-data; name="parentPhone"

087855566677
--{{boundary}}
Content-Disposition: form-data; name="ktpProvinceCode"

31
--{{boundary}}
Content-Disposition: form-data; name="ktpProvinceName"

DKI Jakarta
--{{boundary}}
Content-Disposition: form-data; name="ktpCityCode"

3171
--{{boundary}}
Content-Disposition: form-data; name="ktpCityName"

Jakarta Selatan
--{{boundary}}
Content-Disposition: form-data; name="ktpAddress"

Jl. Fatmawati No. 12, Jakarta Selatan
--{{boundary}}--

###
# 9. GAGAL 400 INVALID_FILE_TYPE: format file ditolak
POST {{baseUrl}}/user/registrations
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="photo"; filename="fake.txt"
Content-Type: text/plain

< ./dummy/fake.txt
--{{boundary}}--

###
# 10. GAGAL 400 LIMIT_FILE_SIZE: file lebih dari 5 MB (butuh ./dummy/big.png)
POST {{baseUrl}}/user/registrations
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="photo"; filename="big.png"
Content-Type: image/png

< ./dummy/big.png
--{{boundary}}--

###
