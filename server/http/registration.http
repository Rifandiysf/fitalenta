Content-Disposition: form-data; name="photo"; filename="photo.png"
Content-Type: image/png

< ./dummy/photo.png
--{{boundary}}--

###
# 12. Daftar pendaftaran milik user
GET {{baseUrl}}/user/registrations

###
# 13. Detail pendaftaran (otomatis memakai registrationId dari response #4)
GET {{baseUrl}}/user/registrations/{{registerProgram.response.body.data.registrationId}}