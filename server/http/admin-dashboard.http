@baseUrl = http://localhost:5000/api
@adminEmail = admin@fitalenta.id
@adminPassword = Admin@123
@participantEmail = siti.rahmawati@example.com
@participantPassword = rahasia123

###
# 0. GAGAL 401: token tidak valid
GET {{baseUrl}}/admin/dashboard/summary
Cookie: access_token=token-palsu

###
# 1. Login admin (cookie tersimpan otomatis)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###
# 2. Kartu statistik: total pendaftar, pendaftar baru 7 hari, total pemasukan, verifikasi tertunda
GET {{baseUrl}}/admin/dashboard/summary

###
# 3. Opsi filter: daftar program + nilai status pembayaran/seleksi/penyaluran
# @name filters
GET {{baseUrl}}/admin/dashboard/filters

###
# 4. Data pendaftar (tanpa filter)
# @name registrations
GET {{baseUrl}}/admin/dashboard/registrations

###
# 5. Pencarian nama
GET {{baseUrl}}/admin/dashboard/registrations?search=andi

###
# 6. Pencarian kode pendaftaran
GET {{baseUrl}}/admin/dashboard/registrations?search=FTL-2026-0003

###
# 7. Pencarian email / telepon
GET {{baseUrl}}/admin/dashboard/registrations?search=081234560005

###
# 8. Filter program (memakai id program pertama dari request #3)
GET {{baseUrl}}/admin/dashboard/registrations?programId={{filters.response.body.$.data.programs[0].id}}

###
# 9. Filter status pembayaran
GET {{baseUrl}}/admin/dashboard/registrations?paymentStatus=pending

###
# 10. Filter status seleksi
GET {{baseUrl}}/admin/dashboard/registrations?selectionStatus=menunggu

###
# 11. Filter status penyaluran
GET {{baseUrl}}/admin/dashboard/registrations?placementStatus=ditempatkan

###
# 12. Kombinasi filter + pencarian
GET {{baseUrl}}/admin/dashboard/registrations?paymentStatus=pending&selectionStatus=lolos&search=rizky

###
# 13. Pagination
GET {{baseUrl}}/admin/dashboard/registrations?page=2&limit=5

###
# 14. GAGAL 400 VALIDATION_ERROR: nilai filter salah
GET {{baseUrl}}/admin/dashboard/registrations?paymentStatus=lunas&page=0&limit=1000&programId=abc

###
# 15. Detail pendaftar (ikon mata): memakai id pertama dari request #4
GET {{baseUrl}}/admin/dashboard/registrations/{{registrations.response.body.$.data[0].id}}

###
# 16. GAGAL 404 REGISTRATION_NOT_FOUND
GET {{baseUrl}}/admin/dashboard/registrations/99999

###
# 17. GAGAL 400 VALIDATION_ERROR: id bukan angka
GET {{baseUrl}}/admin/dashboard/registrations/abc

###
# 18. Login sebagai peserta (buat dulu lewat registration.http #1)
# @name loginParticipant
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{participantEmail}}",
  "password": "{{participantPassword}}"
}

###
# 19. GAGAL 403: peserta mengakses dashboard admin (hanya valid jika #18 berhasil)
GET {{baseUrl}}/admin/dashboard/summary