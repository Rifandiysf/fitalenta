@baseUrl = http://localhost:5000/api
@adminEmail = admin@fitalenta.id
@adminPassword = Admin@123
@participantEmail = siti.rahmawati@example.com
@participantPassword = rahasia123

###
# 0. GAGAL 401: token tidak valid
GET {{baseUrl}}/admin/selection-placements
Cookie: access_token=token-palsu

###
# 1. Login admin
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###
# 2. Ringkasan seleksi & penyaluran (summary cards)
GET {{baseUrl}}/admin/selection-placements/summary

###
# 3. Opsi filter (status seleksi & status penyaluran)
GET {{baseUrl}}/admin/selection-placements/options

###
# 4. Daftar peserta (tanpa filter)
# @name participantList
GET {{baseUrl}}/admin/selection-placements

###
# 5. Pencarian nama peserta
GET {{baseUrl}}/admin/selection-placements?search=siti

###
# 6. Pencarian kode pendaftaran
GET {{baseUrl}}/admin/selection-placements?search=FTL-2026

###
# 7. Pencarian email / telepon
GET {{baseUrl}}/admin/selection-placements?search=siti.rahmawati@example.com

###
# 8. Filter status seleksi: menunggu
GET {{baseUrl}}/admin/selection-placements?selectionStatus=menunggu

###
# 9. Filter status seleksi: lolos
GET {{baseUrl}}/admin/selection-placements?selectionStatus=lolos

###
# 10. Filter status seleksi: tidak lolos
GET {{baseUrl}}/admin/selection-placements?selectionStatus=tidak_lolos

###
# 11. Filter status penyaluran: proses
GET {{baseUrl}}/admin/selection-placements?placementStatus=proses

###
# 12. Filter status penyaluran: lolos
GET {{baseUrl}}/admin/selection-placements?placementStatus=lolos

###
# 13. Filter status penyaluran: ditempatkan
GET {{baseUrl}}/admin/selection-placements?placementStatus=ditempatkan

###
# 14. Filter status penyaluran: tidak lolos
GET {{baseUrl}}/admin/selection-placements?placementStatus=tidak_lolos

###
# 15. Kombinasi filter: seleksi + penyaluran
GET {{baseUrl}}/admin/selection-placements?selectionStatus=lolos&placementStatus=proses

###
# 16. Kombinasi filter + pencarian
GET {{baseUrl}}/admin/selection-placements?selectionStatus=menunggu&search=rizky

###
# 17. Pagination
GET {{baseUrl}}/admin/selection-placements?page=1&limit=5

###
# 18. GAGAL 400 VALIDATION_ERROR: nilai filter tidak valid
GET {{baseUrl}}/admin/selection-placements?selectionStatus=lulus&placementStatus=gagal&page=0&limit=1000

###
# 19. Detail peserta (memakai id pertama dari request #4)
GET {{baseUrl}}/admin/selection-placements/{{participantList.response.body.$.data[0].registrationId}}

###
# 20. GAGAL 404 REGISTRATION_NOT_FOUND
GET {{baseUrl}}/admin/selection-placements/99999

###
# 21. GAGAL 400 VALIDATION_ERROR: id bukan angka
GET {{baseUrl}}/admin/selection-placements/abc

###
# 22. SUKSES: Update status seleksi menjadi "lolos"
# @name updateToLolos
PUT {{baseUrl}}/admin/selection-placements/{{participantList.response.body.$.data[0].registrationId}}
Content-Type: application/json

{
  "selection": {
    "status": "lolos",
    "notes": "Peserta lulus tes wawancara dan tes kemampuan bahasa Jepang"
  }
}

###
# 23. SUKSES: Update status seleksi menjadi "tidak_lolos"
PUT {{baseUrl}}/admin/selection-placements/{{participantList.response.body.$.data[1].registrationId}}
Content-Type: application/json

{
  "selection": {
    "status": "tidak_lolos",
    "notes": "Nilai tes bahasa di bawah standar minimum"
  }
}

###
# 24. SUKSES: Update status seleksi kembali ke "menunggu" (reset)
PUT {{baseUrl}}/admin/selection-placements/{{participantList.response.body.$.data[0].registrationId}}
Content-Type: application/json

{
  "selection": {
    "status": "menunggu",
    "notes": null
  }
}

###
# 25. SUKSES: Update status seleksi ke "lolos" lagi (siap ke penyaluran)
PUT {{baseUrl}}/admin/selection-placements/{{participantList.response.body.$.data[0].registrationId}}
Content-Type: application/json

{
  "selection": {
    "status": "lolos"
  }
}

###
# 26. SUKSES: Update status penyaluran ke "lolos" (peserta sudah lolos seleksi)
PUT {{baseUrl}}/admin/selection-placements/{{participantList.response.body.$.data[0].registrationId}}
Content-Type: application/json

{
  "placement": {
    "status": "lolos",
    "companyName": "PT. Mitra Kerja Jepang",
    "notes": "Peserta siap dikirim ke mitra perusahaan"
  }
}

###
# 27. SUKSES: Update status penyaluran ke "ditempatkan" (dengan tanggal & perusahaan)
PUT {{baseUrl}}/admin/selection-placements/{{participantList.response.body.$.data[0].registrationId}}
Content-Type: application/json

{
  "placement": {
    "status": "ditempatkan",
    "companyName": "Toyota Motor Corporation",
    "placementDate": "2027-01-10",
    "notes": "Peserta resmi ditempatkan di Toyota Motor Corporation, Nagoya"
  }
}

###
# 28. SUKSES: Update seleksi + penyaluran sekaligus
PUT {{baseUrl}}/admin/selection-placements/{{participantList.response.body.$.data[0].registrationId}}
Content-Type: application/json

{
  "selection": {
    "status": "lolos",
    "notes": "Update sekaligus seleksi dan penyaluran"
  },
  "placement": {
    "status": "lolos",
    "companyName": "Panasonic Corp"
  }
}

###
# 29. SUKSES: Update hanya catatan seleksi (status tidak berubah)
PUT {{baseUrl}}/admin/selection-placements/{{participantList.response.body.$.data[0].registrationId}}
Content-Type: application/json

{
  "selection": {
    "status": "lolos",
    "notes": "Catatan diperbarui: peserta konfirmasi keberangkatan tanggal 10 Januari 2027"
  }
}

###
# 30. GAGAL 400 NOTHING_TO_UPDATE: body kosong
PUT {{baseUrl}}/admin/selection-placements/{{participantList.response.body.$.data[0].registrationId}}
Content-Type: application/json

{}

###
# 31. GAGAL 409 SELECTION_NOT_PASSED: penyaluran diubah ke "ditempatkan" padahal belum lolos seleksi
# (Jalankan #23 dulu untuk set peserta ke "tidak_lolos", lalu jalankan ini)
PUT {{baseUrl}}/admin/selection-placements/{{participantList.response.body.$.data[1].registrationId}}
Content-Type: application/json

{
  "placement": {
    "status": "ditempatkan",
    "companyName": "PT. Mitra Jaya",
    "placementDate": "2027-01-10"
  }
}

###
# 32. GAGAL 400 VALIDATION_ERROR: status seleksi tidak valid
PUT {{baseUrl}}/admin/selection-placements/{{participantList.response.body.$.data[0].registrationId}}
Content-Type: application/json

{
  "selection": {
    "status": "lulus"
  }
}

###
# 33. GAGAL 400 VALIDATION_ERROR: status penyaluran tidak valid
PUT {{baseUrl}}/admin/selection-placements/{{participantList.response.body.$.data[0].registrationId}}
Content-Type: application/json

{
  "placement": {
    "status": "belum"
  }
}

###
# 34. GAGAL 400 VALIDATION_ERROR: catatan melebihi batas karakter (5000)
PUT {{baseUrl}}/admin/selection-placements/{{participantList.response.body.$.data[0].registrationId}}
Content-Type: application/json

{
  "selection": {
    "status": "lolos",
    "notes": ""
  }
}

###
# 35. GAGAL 404 REGISTRATION_NOT_FOUND: update peserta tidak ada
PUT {{baseUrl}}/admin/selection-placements/99999
Content-Type: application/json

{
  "selection": {
    "status": "lolos"
  }
}

###
# 36. GAGAL 400 VALIDATION_ERROR: id bukan angka saat update
PUT {{baseUrl}}/admin/selection-placements/abc
Content-Type: application/json

{
  "selection": {
    "status": "lolos"
  }
}

###
# 37. Login sebagai peserta
# @name loginParticipant
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{participantEmail}}",
  "password": "{{participantPassword}}"
}

###
# 38. GAGAL 403: peserta mengakses admin selection-placements
GET {{baseUrl}}/admin/selection-placements
